# Copy to .env and fill in for docker compose. Secrets do not belong here:
# the Django secret key and database passwords are read from secrets/*.txt.

# Required: public host names and HTTPS origins, comma separated.
DJANGO_ALLOWED_HOSTS=electricsting.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=https://electricsting.example.edu

# Keep true in production; the proxy must send X-Forwarded-Proto: https.
DJANGO_SECURE_SSL_REDIRECT=true

# Database name and roles. DB_USER owns the tables and is used only for migrations and backups
# (password in secrets/db_password.txt). The site connects as DB_WEB_USER, which can only read and
# write rows (password in secrets/db_web_password.txt; set up by scripts/apply_postgres_roles.sh).
DB_NAME=fsae
DB_USER=fsae_app
DB_WEB_USER=fsae_web
# Optional, e.g. require when the database is on another host.
DB_SSLMODE=

# Optional error reporting.
SENTRY_DSN=

# Optional branding overrides; defaults are set in docker-compose.yml.
# TEAM_NAME=
# TEAM_SCHOOL=
# TEAM_LOCATION=
# TEAM_EMAIL=
# TEAM_SEASON=
