# Copy to .env and fill in for docker compose. Secrets do not belong here:
# the Django secret key and database password are read from secrets/*.txt.

# Required: public host names and HTTPS origins, comma separated.
DJANGO_ALLOWED_HOSTS=electricsting.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=https://electricsting.example.edu

# Keep true in production; the proxy must send X-Forwarded-Proto: https.
DJANGO_SECURE_SSL_REDIRECT=true

# Staff sign in to /admin/ with a password and a code from an authenticator app. Enroll every
# admin first (README, "Admin accounts and sign-in"); false only as a temporary emergency measure.
DJANGO_ADMIN_REQUIRE_OTP=true

# Database name and user. The password comes from secrets/db_password.txt.
DB_NAME=fsae
DB_USER=fsae_app
# Optional, e.g. require when the database is on another host.
DB_SSLMODE=

# Optional error reporting.
SENTRY_DSN=

# Optional branding overrides; defaults are set in docker-compose.yml.
# TEAM_NAME=
# TEAM_SCHOOL=
# TEAM_LOCATION=
# TEAM_EMAIL=
# TEAM_SEASON=
